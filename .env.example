# URL pública del sitio (usada en metadata, OG image y sitemap/robots).
NEXT_PUBLIC_SITE_URL=https://toro-landing.vercel.app

# LinkedIn de TORO. Pendiente de dato (ver issue OPS-89): si queda vacío,
# el footer no renderiza el ícono.
NEXT_PUBLIC_LINKEDIN_URL=

# Destino del formulario de contacto. El real todavía no está definido.
# Configurar UNA de las dos:
# - CONTACT_WEBHOOK_URL: recibe un POST JSON { name, company, email, message, source }.
# - CONTACT_TO_EMAIL: se registra en los logs del server hasta que se conecte
#   un proveedor de email real (ver src/app/actions/contact.ts).
# Si ninguna está seteada, el formulario sigue funcionando para quien lo
# completa (no rompe build ni deploy) pero el mensaje no se despacha a
# ningún destino externo; queda solo en los logs del server.
CONTACT_WEBHOOK_URL=
CONTACT_TO_EMAIL=
