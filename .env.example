# URL pública del sitio (usada en metadata, OG image, canonical y sitemap/robots).
NEXT_PUBLIC_SITE_URL=https://toro-landing.vercel.app

# LinkedIn de TORO. Pendiente de dato (ver issue OPS-89): si queda vacío,
# el footer no renderiza el ícono.
NEXT_PUBLIC_LINKEDIN_URL=

# Entrega del formulario de contacto. Orden de precedencia (ver
# src/app/actions/contact.ts) — ninguna es obligatoria para build/deploy:
#
# 1. RESEND_API_KEY + CONTACT_TO_EMAIL -> envía por Resend.
# 2. CONTACT_WEBHOOK_URL -> POST JSON { name, company, email, message, source }.
# 3. Ninguna configurada -> se loguea server-side, el formulario igual
#    muestra éxito al usuario (no rompe build ni deploy).
#
# RESEND_API_KEY todavía está pendiente (la cuenta del proveedor la crea
# Rodrigo). CONTACT_TO_EMAIL NO se commitea con un valor real — es un dato
# personal y el repo es público. Placeholder genérico abajo, nunca el real.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_WEBHOOK_URL=
